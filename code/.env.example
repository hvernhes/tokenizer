# Copie ce fichier en .env (jamais commité, voir .gitignore) et renseigne tes propres valeurs.

# URL RPC pour se connecter au testnet Sepolia (endpoint public, ou le tien via
# Infura/Alchemy/QuickNode si tu préfères).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Clé privée du wallet utilisé pour déployer/interagir avec le contrat sur Sepolia.
# Ne JAMAIS committer de vraie clé privée. Wallet dédié au dev/test uniquement,
# jamais un wallet contenant de l'argent réel.
SEPOLIA_PRIVATE_KEY=

# Clé privée d'un second compte (non-owner de Token42BE, propriétaire du multisig
# Multisig42), utilisée par scripts/demo.ts et scripts/demo_bonus.ts pour démontrer
# les cas "refusé" et la gouvernance à plusieurs signatures.
SEPOLIA_PRIVATE_KEY_2=

# Clé API Etherscan, pour la vérification du code source du contrat déployé.
# Gratuite, aucune donnée sensible (donne juste accès à l'API publique Etherscan) — mais on
# garde la même discipline que pour les autres secrets : jamais commitée.
# À récupérer sur https://etherscan.io (compte gratuit) → profil → "API Keys" → "Add".
ETHERSCAN_API_KEY=
